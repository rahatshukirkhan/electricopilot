# =============================================================================
# ElectriCopilot — environment configuration (EXAMPLE, no real secrets)
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# The application reads ONLY from environment variables (or a local .env).
# =============================================================================

# --- LLM access via OpenRouter (OpenAI-compatible gateway to Gemini) ---------
# Get a key at https://openrouter.ai/keys . Leave empty to run the prototype in
# DETERMINISTIC FALLBACK mode (engine + template explanations, no live LLM).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing. Slugs are OpenRouter model ids; confirm with scripts/list_models.py.
# Strong model  -> reasoning / independent verification (Gemini 3.1 Pro).
# Fast model     -> intake parsing / drafting narrative (Gemini 3 Flash).
ELECTRICOPILOT_MODEL_STRONG=google/gemini-3.1-pro-preview
ELECTRICOPILOT_MODEL_FAST=google/gemini-3-flash-preview

# Optional OpenRouter attribution headers (used for their dashboards/rankings).
OPENROUTER_APP_TITLE=ElectriCopilot
OPENROUTER_HTTP_REFERER=https://github.com/rahatshukirkhan/electricopilot

# --- Persistence (optional): Neon / Postgres --------------------------------
# If empty, the app persists audit sessions to local JSONL under ./runs/ .
# Example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# --- Behavior flags ----------------------------------------------------------
# Hard fail if an LLM narrative references a number absent from the audit trace.
ELECTRICOPILOT_STRICT_PROVENANCE=true
# Timeout (seconds) for a single LLM request.
ELECTRICOPILOT_LLM_TIMEOUT=60

# --- Studio API CORS (optional) ---------------------------------------------
# Comma-separated origin allowlist, only needed if the Studio frontend is
# hosted on a DIFFERENT origin than this API (Vercel + local uvicorn both
# serve the UI same-origin, so this is empty by default). Leave empty in
# normal deployments: an unset value means no CORS middleware is added at
# all, so the server-side LLM key can't be called cross-origin from another
# site. Example: ELECTRICOPILOT_ALLOWED_ORIGINS=https://example.com,https://staging.example.com
ELECTRICOPILOT_ALLOWED_ORIGINS=
